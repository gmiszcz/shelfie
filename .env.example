# --- Shelfie environment. Copy to .env (just install does this). Never commit .env. ---

# Listen address and port for the FastAPI server.
HOST=0.0.0.0
PORT=8000

# Path to the SQLite file. A relative path is resolved from the repository root.
DB_PATH=data/shelfie.sqlite

LOG_LEVEL=INFO

# --- Data root & accounts (wave 5) ---
# The data root holds the shared auth DB and the per-user folders data/users/<id>/.
# DATA_DIR=data
# AUTH_DB_PATH=data/auth.sqlite
# Session cookie: 30-day sliding lifetime; renewed when < 15 days remain.
# SESSION_DAYS=30
# SESSION_RENEW_DAYS=15
# Secure cookie flag: auto (HTTPS only), true, or false.
# COOKIE_SECURE=auto
# Setup/reset links valid for this many hours.
# SETUP_TOKEN_HOURS=24
# Login throttle: more than LOGIN_MAX_ATTEMPTS failures per e-mail/IP in the window -> 429.
# LOGIN_WINDOW_MINUTES=15
# LOGIN_MAX_ATTEMPTS=5
# Minimum password length.
# PASSWORD_MIN_LENGTH=10

# --- External APIs ---

# Google Books API key (optional for low volume; raises the daily quota).
# https://console.cloud.google.com/ -> enable "Books API" -> create API key.
GOOGLE_BOOKS_API_KEY=
# Google Books quota safety (wave 5). Live calls are cached on disk and capped per process.
# GOOGLE_BOOKS_MAX_CALLS=50          # per-process live-call budget (0 = forbid live calls)
# GOOGLE_BOOKS_CACHE_DIR=data/cache/google_books
# GOOGLE_BOOKS_CACHE_TTL_DAYS=30     # 0 disables cache reads

# --- Auth (accounts, login, per-user data — wave 5) ---
# Login is e-mail + password (argon2id). Accounts are created by the admin via the CLI
# (`python -m app.cli users ...`) or the admin API. See docs/features/auth.md. The session
# cookie and throttle knobs live in the "Data root & accounts" block above.

# --- AWS (Bedrock library assistant; Transcribe later) ---
AWS_REGION=eu-central-1
# Bedrock inference profile for the chat assistant (strands-compose).
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-5-5
# Credentials come from the standard AWS chain (aws configure / SSO), not from here.

# Bedrock bearer token (alternative to the AWS credential chain for Bedrock calls).
AWS_BEARER_TOKEN_BEDROCK=
# Dedicated IAM credentials for Amazon Transcribe (audio -> text). Separate from the Bedrock chain.
TRANSCRIBE_AWS_ACCESS_KEY_ID=
TRANSCRIBE_AWS_SECRET_ACCESS_KEY=

# --- Data paths (relative to the repository root) ---
# DATASET_PATH=data/books.json
# COVERS_DIR=data/covers

# --- Docker: image tag Compose pulls. Leave unset for :latest. ---
# APP_TAG=latest
